# Ollama (default local setup)
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=mistral
EMBED_MODEL=nomic-embed-text

# Hosted LLM: Groq (free tier) - used by the public demo
# LLM_PROVIDER=groq
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-8b-instant

# CPU embeddings without Ollama (sentence-transformers)
# EMBED_PROVIDER=huggingface
# HF_EMBED_MODEL=BAAI/bge-small-en-v1.5

# Public demo limits
# DEMO_MODE=1
# DEMO_MAX_QUESTIONS=25
# DEMO_MAX_UPLOAD_MB=2

# Sign-in (OIDC provider goes in .streamlit/secrets.toml, see docs/DEPLOY.md)
# AUTH_REQUIRED=1
# AUTH_ALLOWED=@yourcompany.com            # who may sign in; empty = any verified account (reader role)
# AUTH_CONTRIBUTORS=alice@yourcompany.com  # may upload and use re-rank / faithfulness check
# AUTH_ADMINS=you@yourcompany.com          # contributor + today's usage per user
# AUTH_PROVIDER=google                     # only when secrets.toml defines several providers
# QUOTA_QUESTIONS_PER_DAY=50               # per user, 0 = unlimited
# QUOTA_UPLOADS_PER_DAY=5

# Optional: OpenAI-compatible API (set LLM_PROVIDER=openai)
# OPENAI_API_KEY=
# OPENAI_API_BASE=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
